# Gemini (Main LLM + Embedding + Image)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_IMAGE_MODEL=models/nano-banana-pro-preview

# Google Drive sync (choose one auth method)
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Storage (local default)
CHROMA_PERSIST_DIR=./data/vectordb
PROCESSED_CHUNKS_PATH=./data/processed/chunks.jsonl
RAW_PDF_DIR=./data/raw_pdfs

# RAG
TOP_K_RESULTS=5
TEMPERATURE=0.2
MAX_CONTEXT_CHUNKS=8

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=200
